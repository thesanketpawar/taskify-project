# Make sure you are in your project root folder
pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Source code checked out successfully.'
            }
        }
        stage('Build Frontend') {
            steps {
                echo 'Building frontend...'
            }
        }
        stage('Build Backend') {
            steps {
                echo 'Building backend...'
            }
        }
        stage('Test') {
            steps {
                echo 'Running tests...'
            }
        }
    }
}
